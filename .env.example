# RunningHub API 配置
RUNNINGHUB_API_KEY=your api key
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_WEBAPP_ID=1971965779661025281

# 项目配置
INPUT_DIR=./input
OUTPUT_DIR=./outputs
MODELS_DIR=./models
TOOLS_DIR=./tools

# 视频配置
DEFAULT_VIDEO_WIDTH=1920
DEFAULT_VIDEO_HEIGHT=1080
DEFAULT_FPS=30
DEFAULT_AUDIO_BITRATE=192k

# 数字人配置
DIGITAL_HUMAN_NAME=man
DIGITAL_HUMAN_CHARACTERS_DIR=./characters
FULL_DIGITAL_HUMAN_VIDEO=./test/full.mp4
HEAD_DIGITAL_HUMAN_VIDEO=./test/head.mp4

# 数字人图片路径
CHARACTER_IMAGE_PATH=characters/man/input.png
# 参考音频路径
REFERENCE_AUDIO_PATH=characters/man/reference.mp3

# 全身工作室效果图路径
FULL_STUDIO_IMAGE_PATH=models/full_studio_image.png
# 肖像工作室效果图路径
HEAD_STUDIO_IMAGE_PATH=models/head_studio_image.png

# Head模式遮罩配置
MASK_SIZE=320
MASK_POSITION_X=1550
MASK_POSITION_Y=710

# 字幕配置
ENABLE_SUBTITLES=true
SUBTITLE_FONT_SIZE=20
SUBTITLE_TEXT_COLOR=255,255,224,255  # 浅黄色
SUBTITLE_STROKE_COLOR=0,0,0,255    # 黑色描边
SUBTITLE_STROKE_WIDTH=1
SUBTITLE_LINE_SPACING=5
SUBTITLE_BOTTOM_MARGIN=100
SUBTITLE_MAX_WIDTH_RATIO=0.8